# Настройки BOM CONTROL SYSTEM.
#
# Все переменные необязательны: приложение стартует и без них (используется
# PGlite, администратор создаётся при первом запуске).
#
# Запуск с этими значениями:
#   bash:   export $(grep -v '^#' .env.example | xargs) && npm start
#   cmd:    for /f "usebackq tokens=* delims=" %i in (".env.example") do @echo %i
#
# Приложение не ищет файл .env самостоятельно: значения передаются окружением
# процесса (systemd, docker, панель хостинга, оболочка).

# --- Сеть ---
# HOST=0.0.0.0
# PORT=8080

# --- База данных ---
# Если строка не задана, используется встроенная PGlite (данные в каталоге ниже).
# DATABASE_URL=postgresql://bom:пароль@localhost:5432/bom
# PGLITE_DIR=bom-web/server/data

# --- Интерфейс ---
# Каталог собранного интерфейса (npm run build -w web).
# STATIC_DIR=bom-web/web/dist

# --- Сессии ---
# SESSION_TTL_DAYS=14
# Включать только при работе по HTTPS: иначе браузер не отправит cookie.
# COOKIE_SECURE=false

# --- Первый администратор ---
# Используется ровно один раз: пока в базе нет ни одной учётной записи.
# ADMIN_LOGIN=admin
# ADMIN_PASSWORD=admin12345
# ADMIN_NAME=Администратор системы

# --- Журнал ---
# LOG_LEVEL=info
