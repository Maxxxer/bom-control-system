# Зависимости
node_modules/

# Сборка сервера и интерфейса
server/dist/
web/dist/
*.tsbuildinfo

# Данные локальной базы PGlite (создаются при первом запуске)
server/data/

# Каталоги базы после аварийного завершения — это файлы данных, а не исходники
server/data-crashed-*/
**/data-crashed-*/
pgdata/

# Локальные настройки и журналы
.env
*.local
*.log

# Снимки экранов для проверки вёрстки (tools/shoot.mjs) — это артефакт проверки,
# а не исходник
tools/shots/
